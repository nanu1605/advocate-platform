# Copy to .env and fill in. Never commit .env. Server-only keys never ship in the app.

# Core
APP_ENV=local                 # local | staging | production
TZ=Asia/Kolkata               # all schedules run in IST
PUBLIC_BASE_URL=              # public URL of the API (used in ICS links, webhooks)

# Supabase (Mumbai)
SUPABASE_URL=                 # project URL (local: http://127.0.0.1:54321)
SUPABASE_ANON_KEY=            # public anon key, safe in the app
SUPABASE_SERVICE_ROLE_KEY=    # server only, never in the app
SUPABASE_JWKS_URL=            # or JWT secret, per Supabase project settings
DATABASE_URL=                 # postgres connection string used by API and workers

# PowerSync
POWERSYNC_URL=                # PowerSync instance URL (local: http://127.0.0.1:55380, from infra/docker/compose.yml)
POWERSYNC_PRIVATE_KEY=        # for signing client tokens if self-hosted auth is used

# Redis / Celery
REDIS_URL=                    # broker, rate limits, idempotency (local: redis://localhost:6379/0)

# Search
QDRANT_URL=                   # judgment corpus store (P5)
QDRANT_API_KEY=
EMBEDDER_URL=                 # BGE-M3 + reranker service (P2)

# AWS (Mumbai)
AWS_REGION=ap-south-1
BEDROCK_PROFILE_FAST=         # India geographic inference profile IDs from the Bedrock console
BEDROCK_PROFILE_STANDARD=
BEDROCK_PROFILE_DEEP=
S3_BUCKET_EXPORTS=            # data exports, generated PDFs
S3_BUCKET_BACKUPS=            # nightly logical backups
SES_FROM_EMAIL=               # sender address for email (P2)

# Court data
COURTDATA_PRIMARY=ecourtsindia
COURTDATA_LIVE=0              # 0 = recorded fixtures only; 1 = real provider calls
COURTDATA_RATE_MULTIPLIER=3   # 3 on pay-as-you-go, 1 on the Enterprise plan
ECOURTSINDIA_API_BASE=https://webapi.ecourtsindia.com/api/partner
ECOURTSINDIA_API_KEY=
LEGALKART_API_BASE=
LEGALKART_API_KEY=
COURTDATA_GLOBAL_DAILY_CAP_INR=     # hard daily spend cap across all orgs
COURTDATA_ORG_MONTHLY_DEFAULT_INR=  # default per-org budget before plans exist

# Judgments
INDIANKANOON_API_TOKEN=       # P5 research + citation verifier

# Indian-language AI
SARVAM_API_KEY=               # speech-to-text, OCR, translation
BHASHINI_USER_ID=             # fallback only, after founder approves data terms
BHASHINI_API_KEY=

# Messaging
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=     # path or JSON for FCM HTTP v1
WHATSAPP_MODE=meta            # meta | bsp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
SMS_OTP_PROVIDER=             # optional, DLT-registered Indian provider
AUTH_HOOK_SECRET=             # shared secret Supabase signs Send-SMS hook calls with

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Observability
SENTRY_DSN_API=
SENTRY_DSN_APP=
